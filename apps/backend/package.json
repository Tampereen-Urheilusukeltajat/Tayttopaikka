{
  "name": "@tayttopaikka/backend",
  "description": "Backend API for Tayttopaikka",
  "version": "0.0.1",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon",
    "start": "ts-node --transpile-only ./src/app.ts",
    "test": "tsx --experimental-test-module-mocks --test",
    "test:coverage": "tsx --experimental-test-module-mocks --test --experimental-test-coverage",
    "test:watch": "tsx --experimental-test-module-mocks --test --test-concurrency=1 --watch",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier -c .",
    "check-types": "tsc --noEmit",
    "db:migrate:make": "knex migrate:make",
    "db:seed": "knex seed:run",
    "db:seed:make": "knex seed:make"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@scaleway/sdk": "^3.11.1",
    "@sentry/node": "^10.76.0",
    "@sinclair/typebox": "^0.34.52",
    "@tayttopaikka/pricing": "workspace:*",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "knex": "^3.3.0",
    "mysql": "^2.18.1",
    "node-cron": "^4.6.0",
    "redis": "^5.12.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.9.9",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.5",
    "eslint-config-love": "^149.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.3.0",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "prettier-2": "npm:prettier@^3.9.9",
    "tsx": "^4.23.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tampereen-Urheilusukeltajat/Blenderi-Backend.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tampereen-Urheilusukeltajat/Blenderi-Backend/issues"
  },
  "homepage": "https://github.com/Tampereen-Urheilusukeltajat/Blenderi-Backend#readme"
}
